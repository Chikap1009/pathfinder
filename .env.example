# ─────────────────────────────────────────────────────────────────────────────
# PathFinder env template — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Qdrant (vector DB) ---
# Local docker:  http://localhost:6333  | Cloud free: https://<cluster>.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=profiles_v1

# --- Neo4j (knowledge graph) ---
# Local docker: bolt://localhost:7687  | AuraDB Free: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pathfinder
NEO4J_DATABASE=neo4j

# --- Redis (cache + arq jobs) ---
# Local docker: redis://localhost:6379  | Upstash: rediss://default:<token>@<host>:<port>
REDIS_URL=redis://localhost:6379

# --- LiteLLM proxy + model providers (free tiers only) ---
LITELLM_MASTER_KEY=sk-pathfinder-local-dev
LITELLM_PROXY_URL=http://localhost:4000

GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=                     # alias for Gemini in some libs
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=                     # optional — only as last-resort backstop

# --- HuggingFace (optional, for private model gates) ---
HF_TOKEN=
HF_HOME=./hf_cache

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_SERVICE_NAME=pathfinder-api

# --- Frontend (Next.js public env vars must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PathFinder
